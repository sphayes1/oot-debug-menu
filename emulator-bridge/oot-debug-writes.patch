+Kernel::KProcess& Application(ToolState& state) {
+    Kernel::KProcess* const process = state.system.ApplicationProcess();
+    if (process == nullptr) {
+        throw std::runtime_error{"no application process is running"};
+    }
+    return *process;
+}
