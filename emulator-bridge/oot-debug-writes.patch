+json CompareWrite32(ToolState& state, const json& params) {
+    Kernel::KProcess& process = Application(state);
+    const u64 address = AddressParam(params, "address");
+    const u64 expected = AddressParam(params, "expected");
+    const u64 value = AddressParam(params, "value");
+    auto& page_table = process.GetPageTable();
+    ValidateInventoryWordRequest(
+        InventoryWritesEnabled(), process.GetProgramId(), address,
+        GetInteger(page_table.GetHeapRegionStart()), page_table.GetHeapRegionSize(), expected, value);
+    if (state.program_id != OOT_PROGRAM_ID || state.stopping.load(std::memory_order_relaxed)) {
+        throw std::runtime_error{"the Ocarina debug session is not active"};
+    }
+    Kernel::KMemoryInfo info{};
+    Kernel::Svc::PageInfo page{};
+    if (page_table.QueryInfo(&info, &page, address).IsError() ||
+        info.GetState() != Kernel::KMemoryState::Normal ||
+        (info.GetPermission() & Kernel::KMemoryPermission::UserMask) !=
+            (Kernel::KMemoryPermission::UserReadWrite & Kernel::KMemoryPermission::UserMask)) {
+        throw std::runtime_error{"inventory word is not in normal writable heap memory"};
+    }
+    auto& memory = process.GetMemory();
+    if (!memory.IsValidVirtualAddressRange(address, sizeof(u32)) ||
+        GuestByte(memory, address) == nullptr) {
+        throw std::runtime_error{"inventory word is not mapped"};
+    }
+    const bool swapped =
+        memory.WriteExclusive32(address, static_cast<u32>(value), static_cast<u32>(expected));
+    const u32 actual = memory.Read32(address);
+    if (swapped) {
+        LOG_INFO(Debug_GDBStub, "OOT inventory word {:#x}: {:#x} -> {:#x} (readback {:#x})",
+                 address, expected, value, actual);
+    }
+    return {{"address", HexAddress(address)}, {"expected", expected}, {"value", value},
+            {"swapped", swapped}, {"actual", actual}, {"readback_matches", actual == value}};
+}
