+
+inline void ValidateGameDataIntField(std::uint64_t hash, std::uint64_t index,
+                                    std::uint64_t expected, std::uint64_t value) {
+    std::uint64_t limit = 0;
+    switch (hash) {
+    case 0x31ab5580: // Life
+        if (index != 963) throw std::runtime_error{"Life index mismatch"};
+        limit = 80;
+        break;
+    case 0xfbe01da1: // MaxLife
+        if (index != 964) throw std::runtime_error{"MaxLife index mismatch"};
+        limit = 80;
+        if (value < 12 || (value & 3) != 0)
+            throw std::runtime_error{"MaxLife must be whole hearts in [12,80]"};
+        break;
+    case 0x76b18200: // MP
+        if (index != 965) throw std::runtime_error{"MP index mismatch"};
+        limit = 48;
+        break;
+    case 0x12d63a97: // MPMax
+        if (index != 967) throw std::runtime_error{"MPMax index mismatch"};
+        limit = 48;
+        if (value != 0 && value != 24 && value != 48)
+            throw std::runtime_error{"MPMax must be 0,24,48"};
+        break;
+    default:
+        throw std::runtime_error{"GameData Int field is not allowed"};
+    }
+    if (expected > limit || value > limit)
+        throw std::runtime_error{"GameData Int value is out of range"};
+}
+
+inline bool GameDataIntProducerPc(std::uint64_t pc, std::uint64_t module_base) {
