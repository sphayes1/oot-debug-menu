+constexpr std::uint64_t OOT_PROGRAM_ID = 0x0400486024DEC000;
+
+// Mapping and writable-page checks remain the caller's responsibility.
+inline void ValidateInventoryWordRequest(bool enabled, std::uint64_t program_id,
+                                         std::uint64_t address, std::uint64_t heap_start,
+                                         std::uint64_t heap_size, std::uint64_t expected,
+                                         std::uint64_t value) {
+    if (!enabled) {
+        throw std::runtime_error{"live inventory writes require EDEN_NX2_LIVE_INVENTORY=1"};
+    }
+    if (program_id != OOT_PROGRAM_ID) {
+        throw std::runtime_error{"live inventory writes are restricted to Ocarina of Time"};
+    }
+    if ((address >> 48) != 0 || (address & 3) != 0) {
+        throw std::runtime_error{"inventory address must be an aligned guest 32-bit word"};
+    }
+    if (heap_size < 4 || address < heap_start || address - heap_start > heap_size - 4) {
+        throw std::runtime_error{"inventory word must be entirely inside the application heap"};
+    }
+    if (expected > UINT32_MAX || value > UINT32_MAX) {
+        throw std::runtime_error{"expected and value must fit an unsigned 32-bit word"};
+    }
+}
