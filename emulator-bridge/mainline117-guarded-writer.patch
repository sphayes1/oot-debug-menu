+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <cstdint>
+#include <array>
+#include <stdexcept>
+
+namespace Core::Nx2Debug {
+
+constexpr std::uint64_t OOT_BOOL_VTABLE_RVA = 0x4c20658;
+constexpr std::array<std::uint32_t, 16> OOT_GAMEDATA_WRAPPER_SIGNATURE{
+    0xd503237f, 0xa9be7bfd, 0xf9000bf3, 0x910003fd, 0xaa0003f3, 0x91020000,
+    0x9403c8ea, 0x900099a8, 0x910aa108, 0xf9400100, 0x9741262e, 0x91020260,
+    0xf9400bf3, 0xa8c27bfd, 0xd50323ff, 0x1403c8e5};
+constexpr std::array<std::uint32_t, 12> OOT_GAMEDATA_RESERVE_SIGNATURE{
+    0xb941000b, 0xb940f009, 0x12004d6a, 0x6b09015f, 0x5400044a, 0x2a0b03e8,
+    0x1100056c, 0x9104000d, 0x88a87dac, 0x6b0b011f, 0x54000301, 0xf9407c09};
+constexpr std::array<std::uint32_t, 14> OOT_GAMEDATA_COMPLETE_SIGNATURE{
+    0xb941000b, 0x2a0b03e9, 0x12045d6c, 0x1144016d, 0x6a2b015f, 0x1a8d018c,
+    0x9104000d, 0x88a97dac, 0x6b0b013f, 0x2a0903eb, 0x54ffff01, 0x4a080128,
+    0x531c7d08, 0x35000128};
+
+inline void ValidateGameDataModuleBase(std::uint64_t base, std::uint64_t heap) {
+    if (base < 0x10000 || (base & 0xfff) != 0 || base >= heap || heap - base <= 0x4e842b0)
+        throw std::runtime_error{"GameData module base is invalid"};
+}
+
+inline void ValidateGameDataIntField(std::uint64_t hash, std::uint64_t index,
+                                    std::uint64_t expected, std::uint64_t value) {
+    std::uint64_t limit = 0;
+    switch (hash) {
+    case 0x31ab5580: // Life
+        if (index != 963) throw std::runtime_error{"Life index mismatch"};
+        limit = 80;
+        break;
+    case 0xfbe01da1: // MaxLife
+        if (index != 964) throw std::runtime_error{"MaxLife index mismatch"};
+        limit = 80;
+        if (value < 12 || (value & 3) != 0)
+            throw std::runtime_error{"MaxLife must be whole hearts in [12,80]"};
+        break;
+    case 0x76b18200: // MP
+        if (index != 965) throw std::runtime_error{"MP index mismatch"};
+        limit = 48;
+        break;
+    case 0x12d63a97: // MPMax
+        if (index != 967) throw std::runtime_error{"MPMax index mismatch"};
+        limit = 48;
+        if (value != 0 && value != 24 && value != 48)
+            throw std::runtime_error{"MPMax must be 0,24,48"};
+        break;
+    default:
+        throw std::runtime_error{"GameData Int field is not allowed"};
+    }
+    if (expected > limit || value > limit)
+        throw std::runtime_error{"GameData Int value is out of range"};
+}
+
+inline bool GameDataIntProducerPc(std::uint64_t pc, std::uint64_t module_base) {
+    return pc >= module_base && pc - module_base >= 0x163c20 &&
+           pc - module_base < 0x163c98;
+}
+
+inline bool GameDataIntBoundaryIdle(std::uint32_t depth, std::uint32_t owner,
+                                    std::uint32_t header) {
+    return depth == 0 && owner == 0 && (header & 0xfffff) == 0;
+}
+
+inline std::uint32_t CompletedGameDataIntHeader(std::uint32_t header) {
+    if ((header & 0xfffff) != 0)
+        throw std::runtime_error{"GameData Int input queue is not empty"};
+    return (header & 0xf0000000) | (((header + 0x100000) & 0x0ff00000)) | 1;
+}
+
