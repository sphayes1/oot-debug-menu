+json SetGameDataInt(ToolState& state, const json& params) {
+    auto& process = Application(state);
+    auto& table = process.GetPageTable();
+    const u64 task = AddressParam(params, "task");
+    const u64 descriptor = AddressParam(params, "int_descriptor");
+    const u64 module_base = AddressParam(params, "module_base");
+    const u64 hash = AddressParam(params, "hash");
+    const u64 index = AddressParam(params, "index");
+    const u64 expected = AddressParam(params, "expected");
+    const u64 value = AddressParam(params, "value");
+    const u64 heap = GetInteger(table.GetHeapRegionStart());
+    const u64 heap_size = table.GetHeapRegionSize();
+    ValidateInventoryWordRequest(InventoryWritesEnabled(), process.GetProgramId(), task,
+                                 heap, heap_size, expected, value);
+    ValidateGameDataIntField(hash, index, expected, value);
+    ValidateGameDataModuleBase(module_base, heap);
+    if (state.program_id != OOT_PROGRAM_ID || state.stopping.load(std::memory_order_relaxed))
+        throw std::runtime_error{"the Ocarina debug session is not active"};
+    Loader::AppLoader::Modules modules;
+    if (state.system.GetAppLoader().ReadNSOModules(modules) != Loader::ResultStatus::Success)
+        throw std::runtime_error{"GameData loader module metadata is unavailable"};
+    const auto main = modules.find(module_base);
+    if (main == modules.end() || main->second != "main" ||
+        std::count_if(modules.begin(), modules.end(), [](const auto& entry) {
+            return entry.second == "main";
+        }) != 1 ||
+        std::next(main) == modules.end() ||
+        std::next(main)->first < module_base + 0x4e842b0)
+        throw std::runtime_error{"GameData base does not match the loaded main module"};
+    const auto module_mapping = [&](u64 rva, u64 size, Kernel::Svc::MemoryPermission permission) {
+        Kernel::KMemoryInfo info{};
+        Kernel::Svc::PageInfo page{};
+        if (table.QueryInfo(&info, &page, module_base + rva).IsError())
+            throw std::runtime_error{"GameData module anchor is not mapped"};
+        const auto mapping = info.GetSvcMemoryInfo();
+        const bool permission_matches = mapping.permission == permission ||
+            (permission == Kernel::Svc::MemoryPermission::Read &&
+             mapping.permission == Kernel::Svc::MemoryPermission::ReadWrite);
+        if (!permission_matches || mapping.base_address > module_base + rva ||
+            mapping.size < size ||
+            module_base + rva - mapping.base_address > mapping.size - size)
+            throw std::runtime_error{fmt::format(
+                "GameData module anchor {:#x} permission {} or extent mismatch", rva,
+                static_cast<u32>(mapping.permission))};
+    };
+    // NX2 need not carry the legacy module-name header used by GDB discovery.
+    // Use the loader's map and verify each code/data anchor independently.
+    module_mapping(0x3b500a0, OOT_GAMEDATA_WRAPPER_SIGNATURE.size() * 4,
+                   Kernel::Svc::MemoryPermission::ReadExecute);
+    module_mapping(0x163c20, OOT_GAMEDATA_RESERVE_SIGNATURE.size() * 4,
+                   Kernel::Svc::MemoryPermission::ReadExecute);
+    module_mapping(0x163c60, OOT_GAMEDATA_COMPLETE_SIGNATURE.size() * 4,
+                   Kernel::Svc::MemoryPermission::ReadExecute);
+    module_mapping(0x4c1f280, 8, Kernel::Svc::MemoryPermission::Read);
+    module_mapping(0x4c20718, 8, Kernel::Svc::MemoryPermission::Read);
+    module_mapping(0x4c64158, 24, Kernel::Svc::MemoryPermission::Read);
+    module_mapping(0x4e842a8, 8, Kernel::Svc::MemoryPermission::ReadWrite);
+
+    // SuspendEmulation waits for application scheduler threads to leave the cores.
+    // Their contexts are saved by KScheduler::Unload before switching current thread.
+    auto stall = state.system.StallApplication();
+    SCOPE_EXIT { state.system.UnstallApplication(); };
+    auto& memory = process.GetMemory();
+    const auto writable = [&](u64 address, u64 size) {
+        if ((address & 3) != 0 || size == 0 || size > heap_size || address < heap ||
+            address - heap > heap_size - size ||
+            !memory.IsValidVirtualAddressRange(address, size))
+            throw std::runtime_error{"GameData range is outside mapped application heap"};
+        for (u64 at = address; at < address + size;) {
+            Kernel::KMemoryInfo info{};
+            Kernel::Svc::PageInfo page{};
+            if (table.QueryInfo(&info, &page, at).IsError() ||
+                info.GetState() != Kernel::KMemoryState::Normal ||
+                (info.GetPermission() & Kernel::KMemoryPermission::UserMask) !=
+                    (Kernel::KMemoryPermission::UserReadWrite & Kernel::KMemoryPermission::UserMask) ||
+                info.m_address > at || info.m_size == 0 ||
+                info.m_address + info.m_size <= at || GuestByte(memory, at) == nullptr)
+                throw std::runtime_error{"GameData range is not normal writable heap"};
+            at = (std::min)(address + size, info.m_address + info.m_size);
+        }
+    };
+    const auto fixed_string = [&](u64 address, std::string_view expected_text) {
+        std::vector<u8> data(expected_text.size() + 1);
+        if (ReadGuestMemory(memory, address, data) || data.back() != 0 ||
+            std::memcmp(data.data(), expected_text.data(), expected_text.size()) != 0)
+            throw std::runtime_error{"GameData task identity string mismatch"};
+    };
+    const auto busy = [](std::string_view reason) -> json {
+        return {{"queued", false}, {"busy", true}, {"changed", false}, {"reason", reason}};
+    };
+
+    writable(task, 0xa8);
+    writable(descriptor, 96);
+    const auto signature = [&](u64 rva, const auto& words) {
+        std::vector<u8> bytes(words.size() * sizeof(u32));
+        if (ReadGuestMemory(memory, module_base + rva, bytes) ||
+            std::memcmp(bytes.data(), words.data(), bytes.size()) != 0)
+            throw std::runtime_error{"GameData immutable code signature mismatch"};
+    };
+    signature(0x3b500a0, OOT_GAMEDATA_WRAPPER_SIGNATURE);
+    signature(0x163c20, OOT_GAMEDATA_RESERVE_SIGNATURE);
+    signature(0x163c60, OOT_GAMEDATA_COMPLETE_SIGNATURE);
+    // This endpoint is deliberately pinned to the inspected remake revision.
+    if (memory.Read64(task) != module_base + 0x4c64158 ||
+        memory.Read64(module_base + 0x4c64168) != module_base + 0x3b500a0 ||
+        memory.Read64(descriptor) != module_base + 0x4c1f280 ||
+        memory.Read32(descriptor + 8) != 1259 || descriptor < heap + 0xc8 ||
+        memory.Read64(module_base + 0x4e842a8) != descriptor - 0xc8)
+        throw std::runtime_error{"GameData task, descriptor or active manager mismatch"};
+    fixed_string(memory.Read64(task + 0x18), "GameData");
+    const u64 resource = memory.Read64(task + 0xa0);
+    writable(resource, 48);
+    if (memory.Read64(resource) != resource + 48)
+        throw std::runtime_error{"GameData resource string layout mismatch"};
+    fixed_string(memory.Read64(resource), "GameData/GameDataList.Product.110.byml");
+    const u64 bank = memory.Read64(descriptor + 16);
+    const u64 lookup = memory.Read64(descriptor + 24);
+    if (memory.Read32(descriptor + 32) != 1259 ||
+        memory.Read32(descriptor + 36) != 2518 || memory.Read32(descriptor + 40) != 512)
+        throw std::runtime_error{"GameData Int table dimensions mismatch"};
+    writable(bank, 1259 * 40);
+    writable(lookup, 2518 * 8);
+    size_t matches = 0;
+    for (u64 row = 0; row < 2518; ++row) {
+        if (memory.Read32(lookup + row * 8) == hash) {
+            if (memory.Read32(lookup + row * 8 + 4) != index)
+                throw std::runtime_error{"GameData hash/index lookup mismatch"};
+            ++matches;
+        }
+    }
+    const u64 object = bank + index * 40;
+    if (matches != 1 || memory.Read64(bank) != module_base + 0x4c20718 ||
+        memory.Read64(object) != module_base + 0x4c20718)
+        throw std::runtime_error{"GameData Int object type mismatch"};
+    const u64 input = memory.Read64(descriptor + 48);
+    writable(input, 512 * 12);
+
+    // Mapping queries may wait on kernel locks and temporarily continue suspended
+    // lock owners. Re-establish the stop after every such query, then perform the
+    // boundary checks and publication without further kernel-lock acquisition.
+    state.system.Kernel().SuspendEmulation(true);
+    if (!process.GetListLock().TryLock())
+        return busy("application thread list is being modified");
+    SCOPE_EXIT { process.GetListLock().Unlock(); };
+    // Nonblocking ownership also excludes host workers removing a thread.
+    for (const auto& thread : process.GetThreadList()) {
+        if (GameDataIntProducerPc(thread.GetContext().pc, module_base))
+            return busy("native Int producer is between reservation and epoch check");
+    }
+    if (!GameDataIntBoundaryIdle(memory.Read32(task + 0x88), memory.Read32(task + 0x98), 0))
+        return busy("GameData consumer mutex is held");
+    if (memory.Read64(module_base + 0x4e842a8) != descriptor - 0xc8 ||
+        memory.Read64(descriptor + 16) != bank || memory.Read64(descriptor + 24) != lookup ||
+        memory.Read64(descriptor + 48) != input ||
+        memory.Read64(task) != module_base + 0x4c64158 ||
+        memory.Read64(object) != module_base + 0x4c20718)
+        throw std::runtime_error{"GameData binding changed during validation"};
+    const u32 actual = memory.Read32(object + 28);
+    if (actual != expected)
+        return {{"queued", false}, {"busy", false}, {"changed", false},
+                {"reason", "expected value mismatch"}, {"actual", actual}};
+    const u32 header = memory.Read32(descriptor + 56);
+    if (!GameDataIntBoundaryIdle(0, 0, header))
+        return busy("GameData Int input queue is not empty");
+    if (memory.Read32(input) != 0 || memory.Read32(input + 4) != 0 ||
+        memory.Read32(input + 8) != 0)
+        return busy("GameData Int input slot is not cleared");
+    const u32 completed = CompletedGameDataIntHeader(header);
+    // Only zero, validated slot words change until the header publishes the complete record.
+    // No guest thread can observe this intermediate state. Roll back on CAS/readback failure.
+    bool published = false;
+    SCOPE_EXIT {
+        if (!published) {
+            memory.WriteExclusive32(input, 0, static_cast<u32>(value));
+            memory.WriteExclusive32(input + 4, 0, static_cast<u32>(hash));
+        }
+    };
+    if (!memory.WriteExclusive32(input, static_cast<u32>(value), 0) ||
+        !memory.WriteExclusive32(input + 4, static_cast<u32>(hash), 0) ||
+        memory.Read32(input) != value || memory.Read32(input + 4) != hash ||
+        memory.Read32(input + 8) != 0)
+        throw std::runtime_error{"GameData input payload CAS/readback failed"};
+    if (!memory.WriteExclusive32(descriptor + 56, completed, header))
+        throw std::runtime_error{"GameData input header CAS failed"};
+    published = true;
+    const u32 readback = memory.Read32(descriptor + 56);
+    LOG_INFO(Debug_GDBStub, "OOT queued GameData Int {:#x} index {}: {} -> {}", hash,
+             index, expected, value);
+    return {{"queued", true}, {"busy", false}, {"changed", true}, {"hash", hash},
+            {"index", index}, {"expected", expected}, {"value", value},
+            {"header_before", header}, {"header_after", readback},
+            {"readback_matches", readback == completed},
+            {"effect_verified", false}};
+}
